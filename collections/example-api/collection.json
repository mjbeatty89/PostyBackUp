{
  "info": {
    "_postman_id": "12345678-1234-1234-1234-123456789012",
    "name": "Example API Collection",
    "description": "This is an example Postman collection showing best practices for storing collections securely.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get User Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_token}}",
            "type": "text",
            "description": "API token stored as a variable - NEVER commit actual tokens!"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/user/profile",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "user",
            "profile"
          ]
        },
        "description": "Retrieves the authenticated user's profile information"
      },
      "response": []
    },
    {
      "name": "Create Resource",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{api_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Example Resource\",\n  \"description\": \"This is a test resource\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/resources",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "resources"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.example.com",
      "type": "string"
    },
    {
      "key": "api_token",
      "value": "",
      "type": "string",
      "description": "Set this in your Postman environment - DO NOT commit actual values"
    }
  ]
}
